# .env.example
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
#
# cp .env.example .env

# ─── Required: At least one LLM provider ──────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── Recommended: Tavily for web search ───────────────────────────────────────
# Free tier: 1,000 searches/month at tavily.com
# If not set, system falls back to DuckDuckGo (no key needed)
TAVILY_API_KEY=your_tavily_key_here

# ─── Optional: model overrides ────────────────────────────────────────────────
# PRIMARY_MODEL=gpt-4o-mini        # default
# WRITER_MODEL=claude-sonnet-4-5   # default (best prose quality)
# SYNTHESIS_MODEL=claude-sonnet-4-5
# FALLBACK_MODEL=gpt-4o-mini

# ─── Optional: retry and timeout tuning ───────────────────────────────────────
# MAX_RETRIES=5
# MAX_HV_RETRIES=5
# RETRY_DELAY=2
# API_TIMEOUT=120
